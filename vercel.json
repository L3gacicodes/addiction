{
  "functions": {
    "api/*.js": {
      "includeFiles": "",
      "excludeFiles": "{node_modules,dist,build,.git,.trae,.log,.figma}/**"
    }
  },
  "rewrites": [
    { "source": "/api/nova/:path*", "destination": "/api/nova" },
    { "source": "/api/ai-response/:path*", "destination": "/api/ai-response" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
